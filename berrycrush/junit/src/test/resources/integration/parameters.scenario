parameters:
  autoAssertions.enabled: false
  custom:
    port: 8080
    host: localhost

feature: Parameter override test
  outline: Nested parameters test
    parameters:
      custom:
        port: 9090
        host: 127.0.0.1
    given I will check the parameters
      call ^getTest
        auto: [invalid]
    then the param name "{{parameter.name}}" must be {{parameter.value}}
    examples:
      | parameter.name    | parameter.value |
      | param.custom.port | 9090            |
      | param.custom.host | 127.0.0.1       |

outline: Top level parameters test
  given I will check the parameters
    call ^getTest
      auto: [multi]
      excludes: [concurrent]
    assert status -1
  then the param name "{{parameterName}}" must be {{parameterValue}}
  examples:
    | parameterName     | parameterValue |
    | param.custom.port | 8080           |
    | param.custom.host | localhost      |
    | multiTest.mode    | SEQUENTIAL     |